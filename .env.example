# ==============================================================================
#  CTP end-to-end scheduler — ENVIRONMENT REFERENCE
#
#  This file documents EVERY environment variable the code reads. It is a
#  reference + template; copy it and fill in what you need.
#
#  IMPORTANT — two different mechanisms:
#
#    1) DATABASE credentials are read from  db_pipeline/.env  (a dedicated file,
#       loaded by db_pipeline/db_connect.py). Real environment variables of the
#       same name OVERRIDE that file, so CI/cron can inject them instead.
#           cp .env.example db_pipeline/.env      # then edit, keep the DB block
#           (Windows PowerShell:  copy .env.example db_pipeline\.env)
#
#    2) Every OTHER variable below is a plain environment variable read directly
#       by the phases. Nothing auto-loads this file for them — export/set them
#       in your shell before the run:
#           bash / git-bash :   export CTP_PRODUCT=tbr
#           PowerShell      :   $env:CTP_PRODUCT = "tbr"
#           cmd.exe         :   set CTP_PRODUCT=tbr
#
#  NEVER COMMIT the filled-in db_pipeline/.env — .gitignore already blocks it.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. DATABASE  (jkplanning_CTP, MySQL)  — copy this block into db_pipeline/.env
#    Needed ONLY by the default run:  python run_scheduler.py
#    NOT needed by:                   python run_scheduler.py --offline
# ------------------------------------------------------------------------------
DB_USER=your_db_user
DB_PASSWORD=your_password_here
DB_HOST=your.db.host.or.ip
DB_PORT=3306
DB_NAME=jkplanning_CTP

# DB_OFFLINE=1
#   Read the pre-downloaded table dumps in db_pipeline/raw/<table>.csv instead of
#   hitting the live server. Also used automatically as a fallback whenever the
#   live read fails, so a flaky link degrades to the last download instead of
#   crashing. Values: 1 / true / yes.  Default: unset (live).


# ------------------------------------------------------------------------------
# 2. PRODUCT SELECTION
# ------------------------------------------------------------------------------
# CTP_PRODUCT=pcr
#   Which product's master tables to extract and adapt.
#     pcr  (default) — PCR radial only
#     tbr            — swaps every *_pcr table for its *_tbr counterpart
#   Read by: adapt_inputs.py, db_pipeline/db_extract.py, phases/db_loader.py
#   For a COMBINED PCR+TBR run, leave this unset and use the *_comb.csv masters
#   already configured under `ctp_files:` in config.yaml.

# CTP_BOM_GATE=strict
#   phase1b's BOM-identity gate — what to do when a parent's exploded child
#   quantities do not reconcile against the BOM.
#     strict (default) — HARD FAIL on a violation. Use this for production.
#     warn             — log and continue with a flagged first-row pick.
#                        Needed for the combined PCR+TBR run, whose TBR rows use
#                        a per-path (not global-total) BOM convention.


# ------------------------------------------------------------------------------
# 3. PHASE-5 PLACEMENT TOGGLES  (building/TBM assignment)
# ------------------------------------------------------------------------------
# JK_INCH_AWARE=1
#   Default 1 (ON). Match a green tyre's rim inch to a building machine's inch
#   range, so a 16" machine is never pinned to 13" work. Set 0 to disable.

# JK_SOFT_INCH=1
#   Default 1 (ON). The inch match is a PENALTY, not a wall — an off-range
#   machine may still take overflow at a cost. Set 0 to restore the hard gate.

# JK_UPSTREAM_LEAD_H=0
#   Default 0 (off). Hours of head start given to upstream (component) work
#   relative to building. e.g. 72 => upstream may begin 3 days before building.
#   Raising this front-loads components and AGES them — see BUSINESS_RULES.md.

# JK_RESYNC_CHAIN=0
#   Default 0. Enable the short-shelf chain re-sync sweep in phase5. The same
#   switch also exists in config.yaml; the env var is for A/B runs without
#   editing config.

# JK_RESYNC_SWEEPS=40
#   Max sweeps for the above. Only read when the chain re-sync is enabled.


# ------------------------------------------------------------------------------
# 4. DEBUG / AUXILIARY
# ------------------------------------------------------------------------------
# PHASE3_WRITE_XLSX=0
#   Default 0. Set 1 to make phase3 also emit its DAG as .xlsx (slow, large).

# CTP_MES_DIR=
#   Directory holding the plant MES exports, for planning_engine/mes_extract.py.
#   Only used by the separate planning_engine/ tool, never by the scheduler.

# PYTHONUTF8=1
#   Windows only. run_scheduler.py sets this for its child processes already;
#   set it yourself if you invoke run_pipeline.py or a phase directly and see
#   UnicodeEncodeError on the console.
