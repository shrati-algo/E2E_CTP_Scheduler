# Copy this file to `db.env` (same folder) and fill in the values.
# db.env is git-ignored - NEVER commit it. Environment variables of the same
# name take precedence over this file.
# Access is READ-ONLY: run_pipeline.py only runs SELECT queries.
CTP_DB_HOST=
CTP_DB_PORT=3306
CTP_DB_USER=
CTP_DB_PASSWORD=
# the login database (any database the user may open; the tables are read from CTP_PPDS_NAME)
CTP_DB_NAME=
CTP_PPDS_NAME=JK_CTP_PPDS
