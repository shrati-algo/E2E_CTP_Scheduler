# jkplanning_CTP database credentials — used ONLY by  run_scheduler.py --db
# Copy this file to  .env  and fill in the real values, then keep .env private.
#
#   cp .env.example .env      # (Windows:  copy .env.example .env)
#
# The default (reproducible) run does NOT need this file — it uses the adapted CSVs in inputs/.

DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=your.db.host.or.ip
DB_PORT=3306
DB_NAME=jkplanning_CTP
