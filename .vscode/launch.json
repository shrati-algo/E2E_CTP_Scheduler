{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "name": "CTP: run the current plant day (06:30 -> 06:29)",
      "args": []
    },
    {
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "name": "CTP: run a chosen date",
      "args": [
        "--date",
        "${input:planDate}"
      ]
    },
    {
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "name": "CTP: checks only (chosen date)",
      "args": [
        "--date",
        "${input:planDate}",
        "--check-only"
      ]
    },
    {
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "name": "CTP: chosen date + explicit WIP snapshot",
      "args": [
        "--date",
        "${input:planDate}",
        "--wip-sync",
        "${input:wipSync}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "planDate",
      "type": "promptString",
      "description": "Plant day (YYYY-MM-DD)"
    },
    {
      "id": "wipSync",
      "type": "promptString",
      "description": "CTP_Opening_WIP updated_at to use, e.g. 2026-10-27 23:26:13"
    }
  ]
}